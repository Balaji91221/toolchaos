{
  "name": "toolchaos",
  "version": "0.2.1",
  "description": "Deterministic fault injection and recovery assertions",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "bin": {
    "toolchaos": "./dist/cli.js"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "demo": "node dist/cli.js demo",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "start": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "README.md",
    "IMPLEMENTATION_STATUS.md",
    "examples",
    "LICENSE",
    "FEATURE_MATRIX.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs",
    "schemas",
    "CONTRIBUTING.md",
    "PROJECT_PLAN.md"
  ],
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Balaji91221/toolchaos.git"
  },
  "homepage": "https://github.com/Balaji91221/toolchaos#readme",
  "bugs": {
    "url": "https://github.com/Balaji91221/toolchaos/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "fault-injection",
    "testing",
    "reliability"
  ]
}
